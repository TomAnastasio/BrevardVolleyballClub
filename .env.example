# Supabase dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase dashboard → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=

# Optional, e2e tests only: email/password accounts in the *staging* Supabase
# project that Playwright signs in as, bypassing real Google OAuth. Requires
# the Email provider enabled (and "Confirm email" off) on that project's Auth
# settings. Never set these against production.
#
# Admin bot: needs profiles.is_admin=true set by hand via SQL Editor (no
# self-serve way to grant admin) -- used for admin-only flows and seeding.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Player bot: an ordinary account, no special privileges.
E2E_PLAYER_EMAIL=
E2E_PLAYER_PASSWORD=
